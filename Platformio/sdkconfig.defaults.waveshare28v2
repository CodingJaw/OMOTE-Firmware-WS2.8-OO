# Waveshare ESP32-S3-Touch-LCD-2.8 V2 — mixed Arduino/ESP-IDF target
# Use a clean Waveshare-specific IDF config, not the Rev1/4MB defaults.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LITTLEFS_MAX_PARTITIONS=2
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# Waveshare ESP32-S3 board has OPI PSRAM despite the generic DevKitC N8
# variant label ("No PSRAM"). The IDF Kconfig must enable it separately:
# PlatformIO's BOARD_HAS_PSRAM flag alone does not enable IDF PSRAM init.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
